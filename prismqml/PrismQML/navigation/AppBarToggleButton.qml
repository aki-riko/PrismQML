// AppBarToggleButton - WinUI AppBar toggle button 应用栏切换按钮
// Same shell as AppBarButton with toggle semantics always on.
// 与应用栏按钮同壳, 恒定启用切换语义。
AppBarButton {
    id: control

    checkable: true
}
