; Generated by prismqml-installer. DO NOT EDIT.
; Source manifest: $MANIFEST_NAME

#define PrismAppName "$APP_NAME"
#define PrismAppVersion "$APP_VERSION"
#define PrismAppPublisher "$APP_PUBLISHER"
#define PrismAppExe "$APP_EXECUTABLE"
#define PrismAppUserModelID "$APP_USER_MODEL_ID"
#define PrismDistDir "$DIST_DIR"
#define PrismChineseMessagesFile "$CHINESE_MESSAGES_FILE"
$APP_URL_DEFINE
$SETUP_ICON_DEFINE

[Setup]
; A stable AppId makes every version upgrade the same installation. 固定 AppId 保证原位升级。
AppId={{$APP_ID}
AppName={#PrismAppName}
AppVersion={#PrismAppVersion}
AppPublisher={#PrismAppPublisher}
$APP_URL_LINES
DefaultDirName=$DEFAULT_DIR
DefaultGroupName={#PrismAppName}
UsePreviousAppDir=yes
DisableProgramGroupPage=yes
OutputDir=$INSTALLER_OUTPUT_DIR
OutputBaseFilename=$OUTPUT_NAME
$SETUP_ICON_LINE
UninstallDisplayIcon=$UNINSTALL_ICON
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
ShowLanguageDialog=auto
LanguageDetectionMethod=uilanguage
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=$PRIVILEGES
; Close old files; optional relaunch is handled once by [Run]. 关闭旧进程；可选重启由 [Run] 单次执行。
CloseApplications=$CLOSE_APPLICATIONS
RestartApplications=no

[Languages]
Name: "chinesesimplified"; MessagesFile: "{#PrismChineseMessagesFile}"
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

$INSTALL_DELETE_SECTION
[Files]
Source: "{#PrismDistDir}\*"; DestDir: "$PAYLOAD_DIR"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\{#PrismAppName}"; Filename: "$LAUNCH_EXE"; IconFilename: "$LAUNCH_EXE"; AppUserModelID: "{#PrismAppUserModelID}"
Name: "{group}\{cm:UninstallProgram,{#PrismAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#PrismAppName}"; Filename: "$LAUNCH_EXE"; IconFilename: "$LAUNCH_EXE"; AppUserModelID: "{#PrismAppUserModelID}"; Tasks: desktopicon

[Run]
; The manifest decides whether silent installs relaunch the installed application.
; 清单决定静默安装完成后是否重新启动已安装的应用。
Filename: "$LAUNCH_EXE"; Description: "{cm:LaunchProgram,{#PrismAppName}}"; Flags: $RUN_FLAGS$RUN_CHECK

$UNINSTALL_DELETE_SECTION
$DUAL_SLOT_CODE

$EXTENSION_INCLUDE
